<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_uva" model="ir.ui.view">
        <field name="name">res.partner.form.uva</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Sistema UVA" name="uva">
                    <group>
                        <group>
                            <field name="uva_es_cliente"/>
                            <field name="uva_tipo_fiscal" invisible="not uva_es_cliente"/>
                            <field name="uva_codigo_aspel" invisible="not uva_es_cliente"/>
                            <field name="uva_carpeta_sharepoint" invisible="not uva_es_cliente"/>
                        </group>
                        <group>
                            <field name="uva_domicilio_fiscal" invisible="not uva_es_cliente"/>
                            <field name="uva_representante_legal" invisible="not uva_es_cliente"/>
                            <field name="uva_contacto_avisos" invisible="not uva_es_cliente"/>
                        </group>
                    </group>
                    <group string="Aspel SAE" invisible="not uva_es_cliente">
                        <group string="Datos fiscales">
                            <field name="uva_aspel_estatus"/>
                            <field name="uva_curp"/>
                            <field name="uva_nacionalidad"/>
                            <field name="uva_aspel_tipo_empresa"/>
                            <field name="uva_aspel_clasificacion"/>
                            <field name="uva_aspel_zona"/>
                            <field name="uva_aspel_vendedor"/>
                            <field name="uva_aspel_cuenta_contable"/>
                        </group>
                        <group string="Domicilio fiscal">
                            <field name="street" string="Calle"/>
                            <field name="uva_num_exterior"/>
                            <field name="uva_num_interior"/>
                            <field name="uva_entre_calle"/>
                            <field name="uva_y_calle"/>
                            <field name="uva_colonia"/>
                            <field name="zip" string="C.P."/>
                            <field name="city" string="Población"/>
                            <field name="uva_municipio"/>
                            <field name="state_id" string="Estado"/>
                            <field name="country_id" string="País"/>
                            <field name="uva_aspel_referencia"/>
                        </group>
                        <group string="Contacto y crédito">
                            <field name="uva_fax"/>
                            <field name="website"/>
                            <field name="uva_aspel_enviar_cfd"/>
                            <field name="uva_aspel_con_credito"/>
                            <field name="uva_aspel_dias_credito" invisible="not uva_aspel_con_credito"/>
                            <field name="uva_aspel_limite_credito" invisible="not uva_aspel_con_credito"/>
                            <field name="uva_aspel_importado"/>
                        </group>
                        <group string="Domicilio de envío">
                            <field name="uva_envio_calle"/>
                            <field name="uva_envio_num_exterior"/>
                            <field name="uva_envio_num_interior"/>
                            <field name="uva_envio_entre_calle"/>
                            <field name="uva_envio_y_calle"/>
                            <field name="uva_envio_colonia"/>
                            <field name="uva_envio_cp"/>
                            <field name="uva_envio_poblacion"/>
                            <field name="uva_envio_municipio"/>
                            <field name="uva_envio_estado"/>
                            <field name="uva_envio_pais"/>
                            <field name="uva_envio_zona"/>
                            <field name="uva_envio_referencia"/>
                        </group>
                    </group>
                    <field name="uva_pozo_ids" invisible="not uva_es_cliente">
                        <list>
                            <field name="identificador"/>
                            <field name="name"/>
                            <field name="titulo_concesion"/>
                            <field name="uso"/>
                            <field name="medidor_marca"/>
                            <field name="medidor_serie"/>
                            <field name="proxima_inspeccion"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_list_uva" model="ir.ui.view">
        <field name="name">res.partner.list.uva</field>
        <field name="model">res.partner</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list string="Clientes UVA">
                <field name="name"/>
                <field name="vat" string="RFC"/>
                <field name="uva_codigo_aspel"/>
                <field name="uva_representante_legal"/>
                <field name="phone"/>
                <field name="uva_pozo_count"/>
            </list>
        </field>
    </record>

    <record id="action_uva_clientes" model="ir.actions.act_window">
        <field name="name">Clientes y aprovechamientos</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('uva_es_cliente', '=', True)]</field>
        <field name="context">{'default_uva_es_cliente': True, 'default_is_company': True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_partner_list_uva')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('base.view_partner_form')})]"/>
    </record>

    <menuitem id="menu_uva_clientes" name="Clientes y aprovechamientos" parent="menu_uva_catalogos"
              action="action_uva_clientes" sequence="10"/>
</odoo>
